{
  "scripts": {
    "bench": "bun bench/strategies.ts",
    "bench-all": "bun bench/clone.ts && bun bench/helpers.ts && bun bench/game.ts && bun bench/keys.ts && bun bench/strategies.ts",
    "build": "bun src/ui/build.js",
    "watch": "watchexec bun src/ui/build.js",
    "check": "tsc --noEmit",
    "test": "bun test",
    "tournament": "bun src/evals/tournament.ts"
  },
  "dependencies": {
    "convnetjs": "^0.3.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "mitata": "^1.0.34",
    "perfect-arrows": "^0.3.7",
    "reveal.js": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "knip": "^6.42.1",
    "typescript": "^7.0.2"
  },
  "knip": {
    "entry": ["test/*.test.ts", "test/scoring-snapshot.ts", "src/ui/render.ts", "slides.js", "src/evals/*.ts", "src/ml/**/*.ts", "bench/*.ts"],
    "project": ["**/*.{js,ts}"],
    "exclude": ["binaries"]
  }
